{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["DATABASE_URL", "HOST", "NODE_ENV", "PORT", "PUBLIC_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "//#typecheck:oxlint": {
      "inputs": ["tools/oxlint/**"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["MATINEE_*", "VITE_*"]
    }
  }
}
