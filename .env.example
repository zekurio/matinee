# Copy to `.env` in the repository root. The server reads the nearest `.env`
# above its working directory, and variables already set in the environment
# win. The devenv shell exports DATABASE_URL, PORT, and PUBLIC_URL for you.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/matinee

# The origin people open Matinee on. Passkeys and OIDC redirects are bound to
# it, so in production it must be the external https URL. In dev it is the
# Vite origin, which proxies /api to the server.
PUBLIC_URL=http://localhost:5173
PORT=8420
# HOST=::

# Built web app for the server to serve. Leave unset in dev.
# MATINEE_WEB_DIST=apps/web/dist

# ffmpeg and ffprobe to run. jellyfin-ffmpeg is recommended; see README.md.
# MATINEE_FFMPEG_PATH=ffmpeg
# MATINEE_FFPROBE_PATH=ffprobe

# Defaults for Settings -> Transcoding, where admins can change them: the GPU
# to transcode on (none, vaapi, qsv, nvenc, or videotoolbox) and its render
# nodes. An empty QSV device picks the Intel GPU.
# MATINEE_HARDWARE_ACCELERATION=none
# MATINEE_VAAPI_DEVICE=/dev/dri/renderD128
# MATINEE_QSV_DEVICE=

# Encodes are HLS segments on disk, shared by everyone who plays a file the
# same way. They live in transcodes/ under the data dir unless set here; a
# fast disk helps. An encode nobody plays is deleted after the hours below,
# and the least recently played go first once all of them pass the size
# limit in gigabytes (0 for none).
# MATINEE_TRANSCODE_DIR=
# MATINEE_TRANSCODE_CACHE_HOURS=24
# MATINEE_TRANSCODE_CACHE_GB=50

# Scan the folders that change, ten seconds after they stop changing, so an
# import from Sonarr or Radarr shows up on its own. Uses inotify, one watch per
# folder, and only sees changes made on this machine. Set to false to rely on
# the timed scan and Scan now.
# MATINEE_WATCH_LIBRARIES=true

# Hours between full scans of every library, a safety net for changes the
# watcher can't see, like an NFS or SMB share written by another host. 0 turns
# it off. Every library is also scanned a minute after the server starts.
# MATINEE_SCAN_INTERVAL_HOURS=12

# First-run setup. Until the first account exists, the server prints a random
# setup token to its log unless PUBLIC_URL is a loopback address. Set this to
# use a fixed token instead (32+ characters).
# MATINEE_SETUP_TOKEN=

# Let anyone create an account with a passkey on the login page. Off by
# default. OIDC sign-up is a separate switch, below.
# MATINEE_OPEN_REGISTRATION=false

# Single sign-on through one OpenID Connect provider. Admins can set all of this
# under Settings -> Authentication instead; these are defaults for that form.
# Set them here to create the admin account through OIDC on first setup.
# Register $PUBLIC_URL/api/auth/oidc/callback as the redirect URI. Leave the
# secret unset for a public client.
# MATINEE_OIDC_ISSUER_URL=https://auth.example.com
# MATINEE_OIDC_CLIENT_ID=
# MATINEE_OIDC_CLIENT_SECRET=
# MATINEE_OIDC_CLIENT_SECRET_FILE=
# MATINEE_OIDC_DISPLAY_NAME=Pocket ID
# MATINEE_OIDC_SCOPES=openid profile
# MATINEE_OIDC_USERNAME_CLAIM=preferred_username
# Create an account on the first OIDC sign-in. Off means only linked accounts
# sign in. Either way, a username that matches an account asks its owner to
# sign in and link the provider.
# MATINEE_OIDC_ALLOW_SIGN_UP=false

# Metadata providers. Each library picks one; AniList needs no key. The _FILE
# variants read the key from a file instead.
# TMDB: a v3 API key or an API read access token, from themoviedb.org.
# MATINEE_TMDB_API_KEY=
# MATINEE_TMDB_API_KEY_FILE=
# TheTVDB v4: a project API key, plus the subscriber PIN for user keys.
# MATINEE_TVDB_API_KEY=
# MATINEE_TVDB_API_KEY_FILE=
# MATINEE_TVDB_PIN=
