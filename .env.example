# The Nix dev shell creates this file on first entry. The server reads the nearest `.env`
# above its working directory, and variables already set in the environment
# win. The Nix dev shell exports DATABASE_URL, PORT, and PUBLIC_URL for you.
#
# Any variable can come from a file instead: NAME_FILE names the file to read
# NAME from, without its surrounding whitespace, such as a systemd credential.
# Setting both is an error.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/matinee

# The origin people open Matinee on. Passkeys and OIDC redirects are bound to
# it, so in production it must be the external https URL. In dev it is the
# Vite origin, which proxies /api to the server.
PUBLIC_URL=http://localhost:5173
PORT=8420
# HOST=::

# Answer LAN discovery probes on IPv4 UDP 8421 with PUBLIC_URL.
# On by default, but skipped when PUBLIC_URL is a loopback address.
# MATINEE_DISCOVERY_ENABLED=true

# Built web app for the server to serve. Leave unset in dev.
# MATINEE_WEB_DIST=apps/web/dist

# ffmpeg and ffprobe to run. jellyfin-ffmpeg is recommended; see README.md.
# MATINEE_FFMPEG_PATH=ffmpeg
# MATINEE_FFPROBE_PATH=ffprobe

# Defaults for Settings -> Transcoding, where admins can change them: the GPU
# to transcode on (none, vaapi, qsv, nvenc, or videotoolbox) and its render
# nodes. An empty QSV device picks the Intel GPU. With the acceleration set,
# setup doesn't ask for it. A value an admin saves wins over these.
# MATINEE_HARDWARE_ACCELERATION=none
# MATINEE_VAAPI_DEVICE=/dev/dri/renderD128
# MATINEE_QSV_DEVICE=

# Encodes are HLS segments on disk, shared by everyone who plays a file the
# same way. They live in transcodes/ under the data dir unless set here; a
# fast disk helps. An encode nobody plays is deleted after the hours below,
# and the least recently played go first once all of them pass the size
# limit in gigabytes (0 for none).
# MATINEE_TRANSCODE_DIR=
# MATINEE_TRANSCODE_CACHE_HOURS=24
# MATINEE_TRANSCODE_CACHE_GB=50

# Scan the folders that change, ten seconds after they stop changing, so an
# import from Sonarr or Radarr shows up on its own. Uses inotify, one watch per
# folder, and only sees changes made on this machine. Set to false to rely on
# the timed scan and Scan now.
# MATINEE_WATCH_LIBRARIES=true

# Hours between full scans of every library, a safety net for changes the
# watcher can't see, like an NFS or SMB share written by another host. 0 turns
# it off. Every library is also scanned a minute after the server starts.
# MATINEE_SCAN_INTERVAL_HOURS=12

# First-run setup without single sign-on. Until the first account exists,
# the server prints a random setup token to its log unless PUBLIC_URL is a
# loopback address. Set this to use a fixed token instead (32+ characters).
# With MATINEE_OIDC_ISSUER_URL and MATINEE_OIDC_CLIENT_ID set, setup creates
# the admin through the provider instead, and there is no token.
# MATINEE_SETUP_TOKEN=

# Default for open passkey registration under Settings -> Authentication.
# Admins can change it there without a restart. Off by default; invite links
# still let people register. OIDC sign-up is a separate switch, below.
# MATINEE_OPEN_REGISTRATION=false

# Passkey sign-in, sign-up, and setup. Admins can turn passkeys off under
# Settings -> Authentication, and this is the default for that switch. Off
# leaves single sign-on, below, as the only way to sign in. Passkeys stay
# stored for when they're back on.
# MATINEE_PASSKEYS_ENABLED=true

# Single sign-on through one OpenID Connect provider. Admins can set all of this
# under Settings -> Authentication instead; these are defaults for that form,
# and a value an admin saves wins. Set them here to create the admin account
# through OIDC on first setup. Register $PUBLIC_URL/api/auth/oidc/callback as
# the redirect URI. Leave the secret unset for a public client.
# MATINEE_OIDC_ISSUER_URL=https://auth.example.com
# MATINEE_OIDC_CLIENT_ID=
# MATINEE_OIDC_CLIENT_SECRET=
# MATINEE_OIDC_DISPLAY_NAME=Pocket ID
# MATINEE_OIDC_SCOPES=openid profile
# MATINEE_OIDC_USERNAME_CLAIM=preferred_username
# The claim that sets the account's role on every sign-in: admin or user, or
# a list holding them. Setup takes only an admin. Only the provider's admins
# should be able to set it, as with a custom claim on a Pocket ID group.
# MATINEE_OIDC_ROLE_CLAIM=matinee_role
# The groups claim, a string or list. Access groups that follow a provider
# group update on every sign-in. Dotted paths such as realm_access.roles work.
# Only the provider's admins should be able to set this claim. Empty turns it off.
# MATINEE_OIDC_GROUPS_CLAIM=
# The access policy claim, an object or JSON string with libraries, maxBitrate,
# transcode, downloads, and maxStreams. Only the provider's admins should be
# able to set this claim. Empty leaves per-account overrides to Matinee's admins.
# MATINEE_OIDC_POLICY_CLAIM=
# Create an account on the first OIDC sign-in. Off means only linked accounts
# sign in. Either way, a username that matches an account asks its owner to
# sign in and link the provider.
# MATINEE_OIDC_ALLOW_SIGN_UP=false
# Add offline_access to the scopes to keep claims fresh every six hours.
# With this switch on, a refused refresh ends all of the account's sessions.
# Off keeps its sessions and last claims. Both stop retrying the refused token.
# MATINEE_OIDC_SIGN_OUT_REFUSED=false

# Metadata providers. Each library picks one. The two built in take their
# keys here or under Settings -> Plugins, where a saved key wins. Plugins can
# add more providers.
# TMDB: a v3 API key or an API read access token, from themoviedb.org.
# MATINEE_TMDB_API_KEY=
# TheTVDB v4: a project API key, plus the subscriber PIN for user keys.
# MATINEE_TVDB_API_KEY=
# MATINEE_TVDB_PIN=

# Plugins. Admins install them under Settings -> Plugins, from npm or a URL,
# into plugins/ in the data dir, and approve what each one asks for. A folder
# dropped into that directory shows up there too.
# More directories to read plugin folders from, separated by colons. The
# server never writes to them, so they can be read-only.
# MATINEE_PLUGIN_DIRS=
# Ids of plugins from MATINEE_PLUGIN_DIRS to turn on at start, separated by
# commas. Listing one approves what its manifest asks for, in place of an
# admin, for setups that declare their plugins. Read its package.json first.
# MATINEE_PLUGINS_ENABLE=
# Seconds idle before a sandbox sleeps. 0 keeps it awake.
# MATINEE_PLUGIN_IDLE_SECONDS=120
# Soft limit on awake sandboxes. Busy plugins can exceed it.
# MATINEE_PLUGIN_MAX_AWAKE=8
# Most host threads at once. Default is CPU parallelism minus one, between 1 and 4.
# Set 1 to keep all plugins on one thread. Threads start only when needed.
# MATINEE_PLUGIN_THREADS=4
# The npm registry plugins install from, for a mirror or a private one.
# MATINEE_PLUGIN_REGISTRY=https://registry.npmjs.org
