{
  "name": "matinee",
  "version": "0.0.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "api:android": "pnpm --filter @matinee/server api:android",
    "api:dart": "pnpm --filter @matinee/server api:dart",
    "api:ios": "pnpm --filter @matinee/server api:ios",
    "icons:dart": "node apps/flutter/scripts/lucide.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @matinee/server --filter @matinee/web dev",
    "dev:server": "pnpm --filter @matinee/server dev",
    "dev:web": "pnpm --filter @matinee/web dev",
    "logo:dart": "node apps/flutter/scripts/logo.mjs",
    "server-messages:dart": "python3 -B apps/flutter/scripts/server_messages.py",
    "start": "pnpm --filter @matinee/server start",
    "db:generate": "pnpm --filter @matinee/db db:generate",
    "db:migrate": "pnpm --filter @matinee/db db:migrate",
    "db:studio": "pnpm --filter @matinee/db db:studio",
    "themes:dart": "node apps/flutter/scripts/themes.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:oxlint",
    "typecheck:oxlint": "tsc -p tools/oxlint",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm api:android --check && pnpm api:ios --check && pnpm api:dart --check && pnpm themes:dart --check && pnpm icons:dart --check && pnpm logo:dart --check && pnpm server-messages:dart --check && node apps/flutter/scripts/android_strings.mjs --check && pnpm --filter @matinee/tizen strings --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0"
}
