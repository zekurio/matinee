# Tasks for the iOS app. Run `just` in this folder for the list, or
# `just ios <recipe>` from the repository root. XcodeGen comes from Nixpkgs,
# Xcode from the Mac. Builds go to build/ here (git-ignored), so checkouts
# don't share one.

set shell := ["bash", "-euo", "pipefail", "-c"]

app := "io.github.zekurio.matinee"
# Another checkout's or agent's build can share neither: give each its own
# with MATINEE_DERIVED_DATA, under build/.
derived := env("MATINEE_DERIVED_DATA", "build/DerivedData")
simulator := env("MATINEE_SIMULATOR", "iPhone 17")
# The window that shows a booted simulator: Simulator, or DeviceHub from Xcode 27 on. A build
# doesn't need it, so not finding either isn't an error.
show_simulator := 'open -a Simulator 2>/dev/null || open "$(xcode-select -p)/../Applications/DeviceHub.app" 2>/dev/null || true'
built_app := derived / "Build/Products/Debug-iphonesimulator/Matinee.app"
xcodebuild := "xcodebuild -project Matinee.xcodeproj -scheme Matinee -derivedDataPath " + derived
# The Mac's own copy of the kit's boundary test (Matinee/UI/README.md).
boundary := "build/KitBoundary"
# The tests run from Packages/MatineeKitBoundary, which builds on the Mac without the kit;
# both folders are named, since a test's own default is beside the kit's sources.
boundary_roots := 'KIT_BOUNDARY_ROOT="$PWD/../MatineeKit/Sources/MatineeKitGallery" KIT_TV_BOUNDARY_ROOT="$PWD/../MatineeKit/Sources/MatineeKitGallery/TV"'
# The Apple TV app's (MatineeTV/README.md): its own derived data, simulator, and build.
tv_derived := env("MATINEE_TV_DERIVED_DATA", "build/TVDerivedData")
tv_simulator := env("MATINEE_TV_SIMULATOR", "Apple TV 4K (4th generation)")
tv_built_app := tv_derived / "Build/Products/Debug-appletvsimulator/Matinee.app"
tv_xcodebuild := "xcodebuild -project Matinee.xcodeproj -scheme MatineeTV -derivedDataPath " + tv_derived

[private]
default:
    @just --list --unsorted

# Generate with XcodeGen from Nixpkgs, or XCODEGEN on PATH.
generate:
    {{ env("XCODEGEN", "nix run nixpkgs#xcodegen --") }} generate --quiet

# Build for any simulator without booting one; extra xcodebuild flags follow
build *args: generate
    {{ xcodebuild }} -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build {{ args }}

# The simulator's build for running: signed ad hoc, which the Keychain
# needs to keep a sign-in from one launch to the next; unsigned, the app
# signs in and forgets it.
[private]
sim-build: generate
    {{ xcodebuild }} -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- build

# Build, install, and open the app on a simulator (MATINEE_SIMULATOR names it), with launch arguments after
run *args: sim-build
    xcrun simctl boot "{{ simulator }}" 2>/dev/null || true
    {{ show_simulator }}
    xcrun simctl install "{{ simulator }}" "{{ built_app }}"
    xcrun simctl launch --terminate-running-process "{{ simulator }}" {{ app }} {{ args }}

# Open the gallery on the dev server's library (apps/ios/DEV.md), with more launch arguments after
gallery *args: sim-build
    xcrun simctl boot "{{ simulator }}" 2>/dev/null || true
    xcrun simctl install "{{ simulator }}" "{{ built_app }}"
    xcrun simctl launch --terminate-running-process "{{ simulator }}" {{ app }} -gallery YES \
        -gallery.server http://localhost:18420 -gallery.token "$(scripts/dev/token ios-admin)" {{ args }}

# Open the app signed in to the dev server (DEV.md) as `account`, ios-admin or ios-viewer, with more launch arguments after
dev account="ios-admin" *args: sim-build
    xcrun simctl boot "{{ simulator }}" 2>/dev/null || true
    {{ show_simulator }}
    xcrun simctl install "{{ simulator }}" "{{ built_app }}"
    xcrun simctl launch --terminate-running-process "{{ simulator }}" {{ app }} \
        -dev.server http://localhost:18420 -dev.token "$(scripts/dev/token {{ account }})" {{ args }}

# Save what the simulator shows as build/screenshots/<name>.png (MATINEE_SIMULATOR names it)
shot name:
    mkdir -p build/screenshots
    xcrun simctl io "{{ simulator }}" screenshot "build/screenshots/{{ name }}.png"

# Run MatineeCore's tests on the Mac, check that screens build only from the kit, and that the generated files are current
test: boundary
    cd Packages/MatineeCore && swift test
    scripts/lucide.py --kit --check
    scripts/lucide.py --check
    {{ env("NODE", "nix shell nixpkgs#nodejs_24 -c node") }} scripts/themes.mjs --check

# Fail on a stock SwiftUI control outside the kit, but in the folders Matinee/UI/kit-exclusions.txt lets through, and on a phone component in the TV app
boundary: tv-boundary
    cd Packages/MatineeKitBoundary && {{ boundary_roots }} \
        swift test --scratch-path ../../{{ boundary }} -q
    cd Packages/MatineeKitBoundary && {{ boundary_roots }} KIT_BOUNDARY_ROOT="$PWD/../../Matinee/UI" \
        KIT_BOUNDARY_ALLOW_FILE="$PWD/../../Matinee/UI/kit-exclusions.txt" \
        swift test --scratch-path ../../{{ boundary }} -q

# Generate the API client again after a contract change
api:
    cd ../.. && nix shell nixpkgs#nodejs_24 nixpkgs#pnpm_11 -c pnpm api:ios

# Write the kit's icons from Android's, the app's logo from brand/, and the palettes from the web's
icons:
    scripts/lucide.py --kit
    scripts/lucide.py
    {{ env("NODE", "nix shell nixpkgs#nodejs_24 -c node") }} scripts/themes.mjs

# Build the Apple TV app for any tvOS simulator without booting one; extra xcodebuild flags follow
tv-build *args: generate
    {{ tv_xcodebuild }} -configuration Debug -destination 'generic/platform=tvOS Simulator' CODE_SIGNING_ALLOWED=NO build {{ args }}

# The TV simulator's build for running, signed ad hoc as `sim-build` is, for the active architecture only
[private]
tv-sim-build: generate
    {{ tv_xcodebuild }} -configuration Debug -destination 'platform=tvOS Simulator,name={{ tv_simulator }}' CODE_SIGNING_ALLOWED=YES CODE_SIGN_IDENTITY=- build

# Build, install, and open the Apple TV app on a simulator (MATINEE_TV_SIMULATOR names it), with launch arguments after
tv-run *args: tv-sim-build
    xcrun simctl boot "{{ tv_simulator }}" 2>/dev/null || true
    {{ show_simulator }}
    xcrun simctl install "{{ tv_simulator }}" "{{ tv_built_app }}"
    xcrun simctl launch --terminate-running-process "{{ tv_simulator }}" {{ app }} {{ args }}

# Open the Apple TV app signed in to the dev server (DEV.md) as `account`, with more launch arguments after
tv-dev account="ios-admin" *args: tv-sim-build
    xcrun simctl boot "{{ tv_simulator }}" 2>/dev/null || true
    {{ show_simulator }}
    xcrun simctl install "{{ tv_simulator }}" "{{ tv_built_app }}"
    xcrun simctl launch --terminate-running-process "{{ tv_simulator }}" {{ app }} \
        -dev.server http://localhost:18420 -dev.token "$(scripts/dev/token {{ account }})" {{ args }}

# Save what the TV simulator shows as build/tv-screenshots/<name>.png (MATINEE_TV_SIMULATOR names it)
tv-shot name:
    mkdir -p build/tv-screenshots
    xcrun simctl io "{{ tv_simulator }}" screenshot "build/tv-screenshots/{{ name }}.png"

# Drive the TV app with the Siri Remote and take screenshots: run, serve, send, install, or stop (MatineeTV/Remote/remote.sh)
[positional-arguments]
tv-remote *args:
    MATINEE_TV_DERIVED_DATA="{{ tv_derived }}" SIMULATOR="{{ tv_simulator }}" MatineeTV/Remote/remote.sh "$@"

# Start a remote session in the TV app signed in to the dev server as `account`, with more launch arguments after; then `just tv-remote send "<steps>"`
[positional-arguments]
tv-remote-dev account="ios-admin" *args:
    MATINEE_TV_DERIVED_DATA="{{ tv_derived }}" SIMULATOR="{{ tv_simulator }}" MatineeTV/Remote/remote.sh serve \
        "-dev.server http://localhost:18420 -dev.token $(scripts/dev/token "$1") ${*:2}"

# Fail on a phone component, a phone text size, or a stock control in the Apple TV app's screens
tv-boundary:
    cd Packages/MatineeKitBoundary && {{ boundary_roots }} KIT_TV_BOUNDARY_ROOT="$PWD/../../MatineeTV" \
        swift test --scratch-path ../../{{ boundary }} -q

# Delete the build output and the generated project
clean:
    rm -rf build Matinee.xcodeproj Config
    cd Packages/MatineeCore && swift package clean
