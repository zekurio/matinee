/* Text the kit's TV components show or say on their own (TV/TVText.swift).
   Android's copies are in apps/android/app/src/main/res, under the key in
   each comment. */

/* media_watched: the dot on a watched card */
"watched" = "Gesehen";
/* search_clear: the search field's clear button */
"clearSearch" = "Suche leeren";
/* search_title: the search field's placeholder when none is given */
"search" = "Suche";
/* What a held Select does on a card, said by VoiceOver */
"moreActions" = "Für mehr Auswahl gedrückt halten";
/* A card's progress bar, given the percentage watched */
"progress %@" = "%@ gesehen";
