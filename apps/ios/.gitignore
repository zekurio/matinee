# Generated: XcodeGen writes the project and Info.plist, scripts/version.sh
# the version, scripts/appicon.sh copies the icon from brand/ios, and
# scripts/strings.py writes the strings from Android's.
Matinee.xcodeproj/
Matinee/Info.plist
Config/
Matinee/Resources/AppIcon.xcassets/
Matinee/Resources/Localizable.xcstrings
Matinee/UI/Strings.gen.swift
# Build output, kept here so agents' builds don't share one.
build/
DerivedData/
# Xcode writes the app's whole resolution, Nuke included, into the
# Package.resolved of each local package it builds. The app's own pins are
# in project.yml, and a package's in its Package.swift, so these aren't kept.
Packages/*/Package.resolved
