    "NSCameraUsageDescription": {
      "comment": "Why the app asks for the camera.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Matinee nutzt die Kamera, um den Code zu scannen, mit dem du einen Fernseher anmeldest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matinee uses the camera to scan the code a TV shows to sign it in."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Why the app asks for the local network.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Matinee verbindet sich mit deinem Medienserver in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matinee connects to your media server on your local network."
          }
        }
      }
    }
