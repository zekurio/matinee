    "web_oidc_groupsClaim_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Claim, der die Gruppen eines Kontos beim Anbieter auflistet. Bei jeder Anmeldung enthält eine Zugriffsgruppe die Konten der Anbietergruppe, die in ihren Einstellungen steht. Ein Konto ohne den Claim ist in keiner Anbietergruppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The claim that lists an account's groups at the provider. At each sign-in, an access group holds the accounts in the provider group named in its settings. An account without the claim is in no provider groups."
          }
        }
      }
    },
    "web_oidc_issuerUrl_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine spätere Änderung trennt alle verknüpften Konten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing it later unlinks every linked account."
          }
        }
      }
    },
    "web_oidc_issuerUrl_override" : {
