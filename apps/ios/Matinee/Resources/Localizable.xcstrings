    "web_server_jobs_note_artwork" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder von Anbietern, die gleichzeitig geladen und verkleinert werden. Die erste Metadatenabfrage einer Mediathek stellt Tausende in die Warteschlange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provider images downloaded and resized at once. A library's first metadata fetch queues thousands."
          }
        }
      }
    },
    "web_server_jobs_note_download_copies" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, die gleichzeitig kopiert werden. Eine Kopie liest die Datei und wandelt höchstens ihren Ton um; erhöhe den Wert, wenn die Festplatten mithalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads copied at once. A copy reads the file and converts at most its audio; raise it if the disks keep up."
          }
        }
      }
    },
    "web_server_jobs_note_downloads" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads, die gleichzeitig kodiert werden. Jeder belegt einen Encoder wie ein Stream; erhöhe den Wert, wenn der Server mithält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads encoded at once. Each one uses an encoder as a stream would; raise it if the server keeps up."
          }
        }
      }
    },
