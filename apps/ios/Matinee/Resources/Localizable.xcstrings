    "web_oidc_signOutRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten abmelden, die der Anbieter ablehnt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign out accounts the provider refuses"
          }
        }
      }
    },
    "web_oidc_signOutRefused_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet jede Sitzung eines Kontos, sobald der Anbieter es ablehnt, seine Anmeldung zu erneuern, wie bei einem Konto, das er gesperrt oder gelöscht hat. Das erreicht nur Konten mit einem Refresh-Token, wofür es den Scope offline_access braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ends every session of an account once the provider refuses to renew its sign-in, as it does for one it disabled or deleted. This reaches only accounts with a refresh token, which takes the offline_access scope."
          }
        }
      }
    },
    "web_oidc_ssoOnly" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Konto meldet sich nur über %2$@ an. Es kann sich erst wieder anmelden, wenn das wieder an ist."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Konten melden sich nur über %2$@ an. Sie können sich erst wieder anmelden, wenn das wieder an ist."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld account signs in only through %2$@. It can't sign in again until this is back on."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld accounts sign in only through %2$@. They can't sign in again until this is back on."
                }
              }
            }
          }
        }
      }
    },
