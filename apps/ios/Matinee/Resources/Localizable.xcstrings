    "web_oidc_passkeys_allowSignUpHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die diesen Server erreichen, können ein Konto mit Passkey erstellen. Solange das aus ist, braucht eine neue Person einen Einladungslink aus Einstellungen → Benutzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who can reach this server can create an account with a passkey. While this is off, a new person needs an invite link from Settings → Users."
          }
        }
      }
    },
