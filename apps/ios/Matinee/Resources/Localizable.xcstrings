    "web_oidc_passkeys_unlinked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Konto ist nicht mit %2$@ verknüpft und kann sich nicht anmelden, solange Passkeys aus sind. Solange es noch angemeldet ist, kann es %2$@ unter Einstellungen → Konto verknüpfen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Konten sind nicht mit %2$@ verknüpft und können sich nicht anmelden, solange Passkeys aus sind. Solange sie noch angemeldet sind, können sie %2$@ unter Einstellungen → Konto verknüpfen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld account isn't linked to %2$@, so it can't sign in while passkeys are off. While still signed in, it can link %2$@ under Settings → Account."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld accounts aren't linked to %2$@, so they can't sign in while passkeys are off. While still signed in, they can link %2$@ under Settings → Account."
                }
              }
            }
          }
        }
      }
    },
    "web_oidc_policyClaim_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Claim mit den Grenzen eines Kontos, ein Objekt mit beliebigen von libraries, maxBitrate, transcode, downloads und maxStreams. Bei jeder Anmeldung ersetzt er, was unter Benutzer für das Konto eingestellt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The claim that holds one account's limits, an object with any of libraries, maxBitrate, transcode, downloads, and maxStreams. At each sign-in it replaces what's set on the account under Users."
          }
        }
      }
    },
