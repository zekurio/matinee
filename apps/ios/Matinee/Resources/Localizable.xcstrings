    "web_oidc_signOutRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten abmelden, die der Anbieter ablehnt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign out accounts the provider refuses"
          }
        }
      }
    },
    "web_oidc_signOutRefused_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet jede Sitzung eines Kontos, sobald der Anbieter es ablehnt, seine Anmeldung zu erneuern, wie bei einem Konto, das er gesperrt oder gelöscht hat. Das erreicht nur Konten mit einem Refresh-Token, wofür es den Scope offline_access braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ends every session of an account once the provider refuses to renew its sign-in, as it does for one it disabled or deleted. This reaches only accounts with a refresh token, which takes the offline_access scope."
          }
        }
      }
    },
