    "web_jobs_task_find_segments_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht Intro und Abspann von Folgen, die noch nicht untersucht wurden oder deren Datei sich geändert hat, in ihren Kapiteln und im Ton, den sie mit ihrer Staffel teilen. Scans reihen ihre neuen Dateien selbst ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the intro and credits of episodes not looked at yet, or whose file changed, in their chapters and in the audio they share with their season. Scans queue their new files on their own."
          }
        }
      }
    },
