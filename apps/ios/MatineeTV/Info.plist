<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Apple TV app's Info.plist, written by hand (project.yml says why).
  English here; every language's words for these keys are in
  Resources/InfoPlist.xcstrings.
-->
<plist version="1.0">
<dict>
	<key>MatineeAppGroup</key>
	<string>$(MATINEE_APP_GROUP)</string>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLName</key><string>io.github.zekurio.matinee</string><key>CFBundleURLSchemes</key><array><string>matinee</string></array></dict></array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Matinee</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Follow the TV's light or dark appearance; a tvOS app is light only without it. -->
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!--
	  tvOS has no local network privacy today (Apple's TN3179), so nothing
	  asks for this; it's here for the day it does, worded as the iPhone's.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Matinee connects to your media server on your local network.</string>
	<!-- As the iPhone app: servers on a home network often speak plain HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
