+        if let pointer = UnsafeRawPointer(bitPattern: Int(option.mac.macos_parent_view)) {
+            parentView = Unmanaged<NSView>.fromOpaque(pointer).takeUnretainedValue()
+        }
 
         DispatchQueue.main.sync {
             layer = MetalLayer(common: self)
             initMisc(vo)
+            if let parent = parentView, let layer = layer {
+                embed(vo, layer, in: parent)
