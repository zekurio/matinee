     @objc var window: Window?
     var view: View?
+    // The application's layer the video shows in (--macos-parent-layer).
+    // mpv has no window or view of its own then.
+    var parentLayer: CALayer?
+    // The window the video is in: mpv's own, or the one whose view draws
+    // into a layer above the application's.
+    var hostWindow: NSWindow? {
+        if let window = window { return window }
+        var layer = parentLayer
+        while let current = layer {
+            if let view = current.delegate as? NSView { return view.window }
+            layer = current.superlayer
+        }
+        return nil
+    }
