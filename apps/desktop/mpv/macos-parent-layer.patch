+    // Puts the video's layer into the application's, to fill it. Right when
+    // the video output is made, so that the application can tell by its
+    // layer's sublayers whether there is one.
+    func embed(_ layer: MetalLayer, in parent: CALayer) {
+        needsInitialDraw = false
+        layer.frame = parent.bounds
+        layer.autoresizingMask = [.layerWidthSizable, .layerHeightSizable]
+        parent.addSublayer(layer)
+        if hostWindow != nil {
+            updateDisplaylink()
+        }
+        windowDidChangeBackingProperties()
+
+        // The window tells its own delegate what happens to it, not mpv.
+        followHostWindow(NSWindow.didChangeScreenNotification) { [weak self] in
+            self?.updateDisplaylink()
+        }
+        followHostWindow(NSWindow.didChangeBackingPropertiesNotification) { [weak self] in
+            self?.windowDidChangeBackingProperties()
+            self?.flagEvents(VO_EVENT_DPI)
+        }
+        followHostWindow(NSWindow.didChangeOcclusionStateNotification) { [weak self] in
+            self?.windowDidChangeOcclusionState()
+        }
+    }
+
+    func followHostWindow(_ name: NSNotification.Name, _ handler: @escaping () -> Void) {
+        appNotificationObservers.append(NotificationCenter.default.addObserver(
+            forName: name,
+            object: nil,
+            queue: .main,
+            using: { [weak self] notification in
+                guard let window = self?.hostWindow,
+                      (notification.object as? NSWindow) == window else { return }
+                handler()
+            }
+        ))
+    }
+
     @objc func config(_ vo: UnsafeMutablePointer<vo>) -> Bool {
         eventsLock.withLock { self.vo = vo }
 
+        // The layer is in the application's already, and has its size.
+        if parentLayer != nil {
+            windowDidResize()
+            updateICCProfile()
