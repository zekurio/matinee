         timer = PreciseTimer(common: self)
+        if let pointer = UnsafeRawPointer(bitPattern: Int(option.mac.macos_parent_layer)) {
+            parentLayer = Unmanaged<CALayer>.fromOpaque(pointer).takeUnretainedValue()
+        }
 
         DispatchQueue.main.sync {
             layer = MetalLayer(common: self)
             initMisc(vo)
+            if let parent = parentLayer, let layer = layer {
