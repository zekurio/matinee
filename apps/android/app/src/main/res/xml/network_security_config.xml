<?xml version="1.0" encoding="utf-8"?>
<!-- Matinee is self-hosted: servers on a home network often speak plain
     HTTP, or HTTPS with a certificate from the owner's own authority. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
