<?xml version="1.0" encoding="utf-8"?>
<!-- The session token is the device's own: never back it up or move it to
     another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
